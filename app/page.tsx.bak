'use client';

import { useEffect, useRef, useState, useCallback } from 'react';
import { gsap } from 'gsap';
import { LanguageProvider } from '@/context/LanguageContext';
import Loader from '@/components/Loader';
import Navbar from '@/components/Navbar';
import MobileMenu from '@/components/MobileMenu';
import HeroSection from '@/components/HeroSection';
import AboutSection from '@/components/AboutSection';
import SkillsSection from '@/components/SkillsSection';
import PortfolioSection from '@/components/PortfolioSection';
import ContactSection from '@/components/ContactSection';

const SECTION_IDS = ['home', 'about', 'my-skills', 'portfolio', 'contact'];


function Portfolio() {
  const [loaded, setLoaded] = useState(false);
  const [currentSection, setCurrentSection] = useState(0);
  const [menuOpen, setMenuOpen] = useState(false);

  const isScrollingRef = useRef(false);
  const currentIndex = useRef(0);
  const isExpanded = useRef(false);

  const isMobile = () => typeof window !== 'undefined' && window.innerWidth < 768;

  // Animate section items into view via inline styles + staggered setTimeout.
  // Uses setTimeout (not RAF) so animations run even when document.hidden = true.
  const triggerSectionAnimations = useCallback((section: Element) => {
    const items = Array.from(section.querySelectorAll<HTMLElement>('.stagger-item'));
    // Exclude .fade-in elements that live inside an infinite scroller — the
    // scroller container itself (a .stagger-item) animates as one unit, so
    // animating every card individually would create a multi-second delay.
    const fades = Array.from(section.querySelectorAll<HTMLElement>('.fade-in'))
      .filter(el => !el.closest('.scroller'));
    const allItems = [...items, ...fades];
    allItems.forEach((el, i) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(30px)';
      el.style.transition = 'opacity 0.6s cubic-bezier(0.16,1,0.3,1), transform 0.6s cubic-bezier(0.16,1,0.3,1)';
      setTimeout(() => {
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
        el.classList.add('visible');
      }, i * 100 + 16);
    });
  }, []);

  const scrollToSection = useCallback((index: number) => {
    const sections = document.querySelectorAll('.snap-section');
    if (index < 0 || index >= sections.length) return;

    if (isMobile()) {
      const target = sections[index] as HTMLElement;
      const header = document.getElementById('main-header');
      const offset = header?.offsetHeight ?? 0;
      window.scrollTo({ top: target.getBoundingClientRect().top + window.pageYOffset - offset, behavior: 'smooth' });
      return;
    }

    if (isExpanded.current) {
      isExpanded.current = false;
      document.body.classList.remove('expanded-view');
      setTimeout(() => scrollToSection(index), 300);
      return;
    }

    if (isScrollingRef.current) return;
    isScrollingRef.current = true;

    const prevSec = sections[currentIndex.current] as HTMLElement;
    const nextSec = sections[index] as HTMLElement;
    const direction = index > currentIndex.current ? 1 : -1;

    // Reset next section's items so they re-animate on entry.
    // Skip elements inside .scroller — the container is already a stagger-item.
    nextSec.querySelectorAll<HTMLElement>('.stagger-item, .fade-in').forEach(el => {
      if (el.closest('.scroller') && !el.classList.contains('stagger-item')) return;
      el.classList.remove('visible');
      el.style.opacity = '0';
      el.style.transform = 'translateY(30px)';
      el.style.transition = '';
    });

    // Shared completion logic used by both the GSAP path and the instant path
    const onTransitionComplete = () => {
      isScrollingRef.current = false;
      currentIndex.current = index;
      prevSec.classList.remove('active-section');
      nextSec.classList.add('active-section');
      setCurrentSection(index);
      history.replaceState(null, '', `#${SECTION_IDS[index]}`);
      triggerSectionAnimations(nextSec);
      // Cards inside scrollers don't animate individually — force them visible
      // via inline style to overcome the CSS opacity:0 from .fade-in
      nextSec.querySelectorAll<HTMLElement>('.scroller .fade-in, .scroller .project-card').forEach(el => {
        el.style.opacity = '1';
        el.style.transform = 'none';
        el.style.transition = 'none';
      });
      const btn = document.getElementById('back-to-top') as HTMLElement | null;
      if (btn) {
        btn.style.opacity = index > 0 ? '1' : '0';
        btn.style.visibility = index > 0 ? 'visible' : 'hidden';
      }
    };

    // When the tab is hidden, RAF (and therefore GSAP) is throttled by the browser.
    // Use direct DOM manipulation — no GSAP dependency — so the switch is instant.
    if (document.hidden) {
      prevSec.style.opacity = '0';
      prevSec.style.transform = '';
      nextSec.style.opacity = '1';
      nextSec.style.transform = '';
      nextSec.style.visibility = 'visible';
      onTransitionComplete();
      return;
    }

    gsap.timeline({ onComplete: onTransitionComplete })
      .to(prevSec, { opacity: 0, y: -60 * direction, duration: 0.4, ease: 'power2.in' }, 0)
      .fromTo(nextSec,
        { opacity: 0, y: 80 * direction, visibility: 'visible' },
        { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' },
        0.3
      );
  }, [triggerSectionAnimations]);

  // Wheel / touch / keyboard navigation
  useEffect(() => {
    let touchStartY = 0;

    const onWheel = (e: WheelEvent) => {
      if (isMobile() || isExpanded.current) return;
      e.preventDefault();
      if (isScrollingRef.current) return;
      scrollToSection(currentIndex.current + (e.deltaY > 0 ? 1 : -1));
    };
    const onTouchStart = (e: TouchEvent) => { touchStartY = e.touches[0].clientY; };
    const onTouchEnd = (e: TouchEvent) => {
      if (isMobile() || isExpanded.current) return;
      const delta = touchStartY - e.changedTouches[0].clientY;
      if (Math.abs(delta) < 50) return;
      scrollToSection(currentIndex.current + (delta > 0 ? 1 : -1));
    };
    const onKeyDown = (e: KeyboardEvent) => {
      if (isMobile() || isExpanded.current) return;
      if (['ArrowDown', 'PageDown'].includes(e.key)) { e.preventDefault(); scrollToSection(currentIndex.current + 1); }
      if (['ArrowUp', 'PageUp'].includes(e.key)) { e.preventDefault(); scrollToSection(currentIndex.current - 1); }
    };

    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('touchstart', onTouchStart, { passive: true });
    window.addEventListener('touchend', onTouchEnd, { passive: true });
    window.addEventListener('keydown', onKeyDown);
    return () => {
      window.removeEventListener('wheel', onWheel);
      window.removeEventListener('touchstart', onTouchStart);
      window.removeEventListener('touchend', onTouchEnd);
      window.removeEventListener('keydown', onKeyDown);
    };
  }, [scrollToSection]);

  // Mobile scroll: sync active nav section
  useEffect(() => {
    const onScroll = () => {
      if (!isMobile()) return;
      const sections = document.querySelectorAll('.snap-section');
      let active = 0;
      sections.forEach((sec, i) => {
        if ((sec as HTMLElement).getBoundingClientRect().top <= window.innerHeight / 2) active = i;
      });
      if (active !== currentIndex.current) {
        currentIndex.current = active;
        setCurrentSection(active);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    return () => window.removeEventListener('scroll', onScroll);
  }, []);

  // Mobile: IntersectionObserver for stagger animations
  useEffect(() => {
    if (!loaded) return;
    const io = new IntersectionObserver(entries => {
      if (!isMobile()) return;
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        triggerSectionAnimations(entry.target);
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.snap-section').forEach(s => io.observe(s));
    return () => io.disconnect();
  }, [loaded, triggerSectionAnimations]);

  // Sync expanded ref
  useEffect(() => {
    const obs = new MutationObserver(() => {
      isExpanded.current = document.body.classList.contains('expanded-view');
    });
    obs.observe(document.body, { attributes: true, attributeFilter: ['class'] });
    return () => obs.disconnect();
  }, []);

  // Initial load
  useEffect(() => {
    document.body.classList.add('portfolio-page');
    const t = setTimeout(() => {
      setLoaded(true);
      const hero = document.getElementById('home');
      if (hero) triggerSectionAnimations(hero);
    }, 800);
    return () => { clearTimeout(t); document.body.classList.remove('portfolio-page'); };
  }, [triggerSectionAnimations]);

  return (
    <div className="portfolio-root">
      <Loader hidden={loaded} />
      {/* @ts-ignore */}
      <spline-viewer id="spline-bg" url="/models/bg_scene.splinecode" />

      <Navbar currentSection={currentSection} onScrollTo={scrollToSection} onMenuOpen={() => setMenuOpen(true)} />
      <MobileMenu isOpen={menuOpen} onClose={() => setMenuOpen(false)} onScrollTo={scrollToSection} />

      <main id="main-scroller">
        <HeroSection onScrollTo={scrollToSection} />
        <AboutSection />
        <SkillsSection />
        <PortfolioSection />
        <ContactSection />
      </main>

      <button
        id="back-to-top"
        onClick={() => scrollToSection(0)}
        className="liquid-glass-btn liquid-glass-gradient w-12 h-12 rounded-full"
        style={{ opacity: 0, visibility: 'hidden' }}
        aria-label="Back to top"
      >
        <i className="fas fa-arrow-up" />
      </button>
    </div>
  );
}

export default function Page() {
  return (
    <LanguageProvider>
      <Portfolio />
    </LanguageProvider>
  );
}
